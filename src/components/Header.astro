<header>
  <a class="brand" href="#"><img src="/logo.svg" width="30" height="30" alt="">Lugas</a>
  <button class="menu" id="menu" aria-label="Menu" aria-expanded="false" aria-controls="navLinks"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button><nav><span class="links" id="navLinks"><a href="#demo" data-i="navDemo">Contoh</a><a href="#walk" data-i="navWalk">Demo</a><a href="#how" data-i="navHow">How</a><a href="#structure" id="navStr">Structure</a><a href="#check" data-i="navCheck">Check</a><a href="#install" data-i="navInstall">Instal</a><a href="#batas" data-i="navLimits">Batasan</a><a href="https://github.com/bryankwandou/lugas">GitHub</a></span><select class="lang" id="lang" aria-label="Language"><option value="en">English</option><option value="id">Indonesia</option><option value="es">Español</option><option value="ja">日本語</option><option value="zh">中文</option><option value="ms">Melayu</option><option value="jv">Jawa</option><option value="su">Sunda</option><option value="ko">한국어</option><option value="ar">العربية</option></select><span class="theme" id="theme" role="group"><button data-t="auto" aria-pressed="true" title="System"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8"/></svg></button><button data-t="light" aria-pressed="false" title="Light"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></button><button data-t="dark" aria-pressed="false" title="Dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg></button></span></nav>
</header>
<script>
import { setLang } from "../scripts/i18n.js";
/* Theme: auto / light / dark, persisted; the inline head script prevents a flash. */
const box = document.getElementById("theme");
const read = () => { try { const v = localStorage.getItem("lugas-theme"); return v === "light" || v === "dark" ? v : "auto"; } catch (e) { return "auto"; } };
function apply(t) {
  if (t === "auto") document.documentElement.removeAttribute("data-theme");
  else document.documentElement.setAttribute("data-theme", t);
  box.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.t === t)));
  try { t === "auto" ? localStorage.removeItem("lugas-theme") : localStorage.setItem("lugas-theme", t); } catch (e) {}
}
box.addEventListener("click", (e) => { const b = e.target.closest("button"); if (b && b.dataset.t) apply(b.dataset.t); });
apply(read());
matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (read() === "auto") apply("auto"); });
const menu = document.getElementById("menu"), hdr = document.querySelector("header");
menu.addEventListener("click", () => { const o = hdr.classList.toggle("open"); menu.setAttribute("aria-expanded", String(o)); });
document.getElementById("navLinks").addEventListener("click", (e) => { if (e.target.closest("a")) { hdr.classList.remove("open"); menu.setAttribute("aria-expanded", "false"); } });
document.addEventListener("keydown", (e) => { if (e.key === "Escape" && hdr.classList.contains("open")) { hdr.classList.remove("open"); menu.setAttribute("aria-expanded", "false"); menu.focus(); } });
document.getElementById("lang").addEventListener("change", (e) => setLang(e.target.value));
</script>
